{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kody-w/rapp-1/main/protocols/rapp-trust/1/schema.json",
  "title": "RAPP Trust ledger genesis, wager, and settlement payloads",
  "description": "Closed payload structures. Chain position, stake-versus-score, single settlement and expiry are checked by the reader, not by this schema.",
  "oneOf": [
    {"$ref": "#/$defs/genesis"},
    {"$ref": "#/$defs/wager"},
    {"$ref": "#/$defs/settle"}
  ],
  "$defs": {
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "label": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64},
    "rappid": {"type": "string", "pattern": "^rappid:@[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*:[0-9a-f]{64}$"},
    "words": {"type": "string", "minLength": 1, "maxLength": 256},
    "evidence_item": {"type": "string", "pattern": "^(https://.+|sha256:[0-9a-f]{64}|path:[^\\s].*|log:.+)$", "maxLength": 512},
    "genesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "subject", "owner", "base"],
      "properties": {
        "schema": {"const": "trust-ledger/1"},
        "subject": {"$ref": "#/$defs/rappid"},
        "owner": {"$ref": "#/$defs/label"},
        "base": {"const": 100}
      }
    },
    "wager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "claim", "class", "stake", "counter", "evidence_required", "settles_by"],
      "properties": {
        "schema": {"const": "trust.wager"},
        "claim": {"$ref": "#/$defs/words"},
        "class": {"enum": ["statement", "done", "release", "destructive"]},
        "stake": {"type": "integer", "minimum": 1, "maximum": 50},
        "counter": {"type": "integer", "minimum": 0, "maximum": 50},
        "evidence_required": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/words"}},
        "settles_by": {"$ref": "#/$defs/utc"}
      },
      "allOf": [
        {"if": {"properties": {"class": {"const": "done"}}}, "then": {"properties": {"stake": {"minimum": 5}}}},
        {"if": {"properties": {"class": {"const": "release"}}}, "then": {"properties": {"stake": {"minimum": 10}}}},
        {"if": {"properties": {"class": {"const": "destructive"}}}, "then": {"properties": {"stake": {"minimum": 20}}}}
      ]
    },
    "settle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "wager", "outcome", "evidence", "note"],
      "properties": {
        "schema": {"const": "trust.settle"},
        "wager": {"$ref": "#/$defs/hex64"},
        "outcome": {"enum": ["won", "lost", "void"]},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/evidence_item"}},
        "note": {"type": "string", "maxLength": 256}
      }
    }
  }
}
