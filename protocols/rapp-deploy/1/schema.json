{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kody-w/rapp-1/main/protocols/rapp-deploy/1/schema.json",
  "title": "RAPP Deploy v1 payloads",
  "oneOf": [
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/health"
    },
    {
      "$ref": "#/$defs/decision"
    }
  ],
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "httpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "nullableHash": {
      "oneOf": [
        {
          "$ref": "#/$defs/hex64"
        },
        {
          "type": "null"
        }
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "region",
        "failure_domain",
        "tenant_scope"
      ],
      "properties": {
        "cell_id": {
          "$ref": "#/$defs/label"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "failure_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tenant_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "traffic_basis_points",
        "minimum_observation_seconds",
        "minimum_healthy_windows",
        "cell_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/label"
        },
        "traffic_basis_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "minimum_observation_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_healthy_windows": {
          "type": "integer",
          "minimum": 1
        },
        "cell_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/label"
          }
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit",
        "operator",
        "threshold"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/label"
        },
        "unit": {
          "$ref": "#/$defs/label"
        },
        "operator": {
          "enum": [
            "eq",
            "gte",
            "lte"
          ]
        },
        "threshold": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit",
        "value",
        "evidence_sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/label"
        },
        "unit": {
          "$ref": "#/$defs/label"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_sha256": {
          "$ref": "#/$defs/hex64"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "release_payload_hash",
        "release_scope",
        "created_utc",
        "deployment_class",
        "promotion_payload_hash",
        "serving",
        "topology",
        "waves",
        "health_contract",
        "state",
        "data",
        "resilience",
        "rollback_release_payload_hash",
        "automatic_pause",
        "automatic_rollback"
      ],
      "properties": {
        "schema": {
          "const": "rapp-deploy/1-plan"
        },
        "release_payload_hash": {
          "$ref": "#/$defs/hex64"
        },
        "release_scope": {
          "$ref": "#/$defs/httpsUri"
        },
        "created_utc": {
          "$ref": "#/$defs/utc"
        },
        "deployment_class": {
          "enum": [
            "single-cell",
            "multi-cell",
            "planetary"
          ]
        },
        "promotion_payload_hash": {
          "$ref": "#/$defs/hex64"
        },
        "serving": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_isolated",
            "in_place_mutation",
            "current_release_payload_hash"
          ],
          "properties": {
            "candidate_isolated": {
              "const": true
            },
            "in_place_mutation": {
              "const": false
            },
            "current_release_payload_hash": {
              "$ref": "#/$defs/nullableHash"
            }
          }
        },
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "cells"
          ],
          "properties": {
            "mode": {
              "const": "cellular"
            },
            "cells": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/cell"
              }
            }
          }
        },
        "waves": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/wave"
          }
        },
        "health_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_evidence_age_seconds",
            "objectives"
          ],
          "properties": {
            "max_evidence_age_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "objectives": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/objective"
              }
            }
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "schema_sha256",
            "migration",
            "backward_compatible",
            "rollback_snapshot_sha256",
            "rollback_evidence_sha256",
            "restore_evidence_sha256",
            "recovery_point_objective_seconds",
            "recovery_time_objective_seconds",
            "previous_schema_sha256",
            "compatibility_evidence_sha256"
          ],
          "properties": {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "schema_sha256": {
              "$ref": "#/$defs/hex64"
            },
            "previous_schema_sha256": {
              "$ref": "#/$defs/hex64"
            },
            "compatibility_evidence_sha256": {
              "$ref": "#/$defs/hex64"
            },
            "migration": {
              "enum": [
                "none",
                "expand-contract",
                "dual-read-write"
              ]
            },
            "backward_compatible": {
              "const": true
            },
            "rollback_snapshot_sha256": {
              "$ref": "#/$defs/nullableHash"
            },
            "rollback_evidence_sha256": {
              "$ref": "#/$defs/hex64"
            },
            "restore_evidence_sha256": {
              "$ref": "#/$defs/hex64"
            },
            "recovery_point_objective_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "recovery_time_objective_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenant_isolation",
            "residency_policy_sha256",
            "retention_policy_sha256",
            "deletion_policy_sha256",
            "backup_policy_sha256"
          ],
          "properties": {
            "tenant_isolation": {
              "const": true
            },
            "residency_policy_sha256": {
              "$ref": "#/$defs/hex64"
            },
            "retention_policy_sha256": {
              "$ref": "#/$defs/hex64"
            },
            "deletion_policy_sha256": {
              "$ref": "#/$defs/hex64"
            },
            "backup_policy_sha256": {
              "$ref": "#/$defs/hex64"
            }
          }
        },
        "resilience": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "controls",
            "provider_failure_mode"
          ],
          "properties": {
            "controls": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/label"
              }
            },
            "provider_failure_mode": {
              "enum": [
                "fail-closed",
                "degrade-explicitly"
              ]
            }
          }
        },
        "rollback_release_payload_hash": {
          "$ref": "#/$defs/nullableHash"
        },
        "automatic_pause": {
          "const": true
        },
        "automatic_rollback": {
          "const": true
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "deployment_payload_hash",
        "release_payload_hash",
        "cell_id",
        "wave_id",
        "window_start_utc",
        "window_end_utc",
        "observed",
        "measurements",
        "verdict",
        "reason_codes",
        "previous_health_payload_hash"
      ],
      "properties": {
        "schema": {
          "const": "rapp-deploy/1-health"
        },
        "deployment_payload_hash": {
          "$ref": "#/$defs/hex64"
        },
        "release_payload_hash": {
          "$ref": "#/$defs/hex64"
        },
        "cell_id": {
          "$ref": "#/$defs/label"
        },
        "wave_id": {
          "$ref": "#/$defs/label"
        },
        "window_start_utc": {
          "$ref": "#/$defs/utc"
        },
        "window_end_utc": {
          "$ref": "#/$defs/utc"
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_sha256",
            "grail_id",
            "grail_path",
            "grail_sha256",
            "grail_size_bytes",
            "model_set_payload_hash",
            "tool_set_payload_hash",
            "state_schema_sha256"
          ],
          "properties": {
            "artifact_sha256": {
              "$ref": "#/$defs/hex64"
            },
            "grail_id": {
              "type": "string",
              "pattern": "^grail:[0-9a-f]{64}$"
            },
            "grail_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "grail_sha256": {
              "$ref": "#/$defs/hex64"
            },
            "grail_size_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "model_set_payload_hash": {
              "$ref": "#/$defs/hex64"
            },
            "tool_set_payload_hash": {
              "$ref": "#/$defs/hex64"
            },
            "state_schema_sha256": {
              "$ref": "#/$defs/hex64"
            }
          }
        },
        "measurements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/measurement"
          }
        },
        "verdict": {
          "enum": [
            "healthy",
            "unhealthy"
          ]
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/label"
          }
        },
        "previous_health_payload_hash": {
          "$ref": "#/$defs/nullableHash"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "deployment_payload_hash",
        "release_payload_hash",
        "wave_id",
        "action",
        "health_payload_hashes",
        "health_heads",
        "target_release_payload_hash",
        "previous_decision_payload_hash",
        "decided_utc"
      ],
      "properties": {
        "schema": {
          "const": "rapp-deploy/1-decision"
        },
        "deployment_payload_hash": {
          "$ref": "#/$defs/hex64"
        },
        "release_payload_hash": {
          "$ref": "#/$defs/hex64"
        },
        "wave_id": {
          "$ref": "#/$defs/label"
        },
        "action": {
          "enum": [
            "advance",
            "complete",
            "hold",
            "rollback",
            "quarantine"
          ]
        },
        "health_payload_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hex64"
          }
        },
        "health_heads": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "payload_hash",
              "window_end_utc"
            ],
            "properties": {
              "payload_hash": {
                "$ref": "#/$defs/hex64"
              },
              "window_end_utc": {
                "$ref": "#/$defs/utc"
              }
            }
          }
        },
        "target_release_payload_hash": {
          "$ref": "#/$defs/nullableHash"
        },
        "previous_decision_payload_hash": {
          "$ref": "#/$defs/nullableHash"
        },
        "decided_utc": {
          "$ref": "#/$defs/utc"
        }
      }
    }
  }
}
