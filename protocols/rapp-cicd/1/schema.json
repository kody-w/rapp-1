{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kody-w/rapp-1/main/protocols/rapp-cicd/1/schema.json",
  "title": "RAPP CI/CD v1 payloads",
  "oneOf": [
    {
      "$ref": "#/$defs/release"
    },
    {
      "$ref": "#/$defs/policy"
    },
    {
      "$ref": "#/$defs/evidence"
    },
    {
      "$ref": "#/$defs/promotion"
    }
  ],
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grailId": {
      "type": "string",
      "pattern": "^grail:[0-9a-f]{64}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "httpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "object_format",
        "commit",
        "tree"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/httpsUri"
        },
        "object_format": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "tree": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes",
        "media_type",
        "entrypoint"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/hex64"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
        }
      }
    },
    "grail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grail_id",
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "grail_id": {
          "$ref": "#/$defs/grailId"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"
        },
        "sha256": {
          "$ref": "#/$defs/hex64"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "version",
        "sha256",
        "mutable"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/label"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "$ref": "#/$defs/hex64"
        },
        "mutable": {
          "type": "boolean"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "release_scope",
        "created_utc",
        "source",
        "artifact",
        "grail",
        "components",
        "lineage"
      ],
      "properties": {
        "schema": {
          "const": "rapp-cicd/1-release"
        },
        "release_scope": {
          "$ref": "#/$defs/httpsUri"
        },
        "created_utc": {
          "$ref": "#/$defs/utc"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "grail": {
          "$ref": "#/$defs/grail"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "parents"
          ],
          "properties": {
            "mode": {
              "enum": [
                "seed",
                "offspring",
                "cross"
              ]
            },
            "parents": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "space",
                  "hash"
                ],
                "properties": {
                  "space": {
                    "enum": [
                      "rapp/1:particle",
                      "rapp/1:egg-manifest"
                    ]
                  },
                  "hash": {
                    "$ref": "#/$defs/hex64"
                  }
                }
              }
            }
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "required_checks",
        "minimum_soak_seconds",
        "maximum_evidence_age_seconds",
        "approval"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/label"
        },
        "class": {
          "enum": [
            "development",
            "test",
            "canary",
            "qualification",
            "preprod",
            "production"
          ]
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/label"
          }
        },
        "minimum_soak_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_evidence_age_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "approval": {
          "enum": [
            "automatic",
            "owner"
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "release_scope",
        "created_utc",
        "stages"
      ],
      "properties": {
        "schema": {
          "const": "rapp-cicd/1-policy"
        },
        "release_scope": {
          "$ref": "#/$defs/httpsUri"
        },
        "created_utc": {
          "$ref": "#/$defs/utc"
        },
        "stages": {
          "type": "array",
          "minItems": 6,
          "items": {
            "$ref": "#/$defs/stage"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "evidence_sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/label"
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "evidence_sha256": {
          "$ref": "#/$defs/hex64"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "release_payload_hash",
        "policy_payload_hash",
        "stage_id",
        "stage_class",
        "environment_sha256",
        "started_utc",
        "completed_utc",
        "artifact_sha256",
        "grail_id",
        "checks",
        "result",
        "previous_evidence_payload_hash"
      ],
      "properties": {
        "schema": {
          "const": "rapp-cicd/1-evidence"
        },
        "release_payload_hash": {
          "$ref": "#/$defs/hex64"
        },
        "policy_payload_hash": {
          "$ref": "#/$defs/hex64"
        },
        "stage_id": {
          "$ref": "#/$defs/label"
        },
        "stage_class": {
          "enum": [
            "development",
            "test",
            "canary",
            "qualification",
            "preprod",
            "production"
          ]
        },
        "environment_sha256": {
          "$ref": "#/$defs/hex64"
        },
        "started_utc": {
          "$ref": "#/$defs/utc"
        },
        "completed_utc": {
          "$ref": "#/$defs/utc"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/hex64"
        },
        "grail_id": {
          "$ref": "#/$defs/grailId"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "previous_evidence_payload_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/hex64"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "release_payload_hash",
        "policy_payload_hash",
        "from_stage_id",
        "to_stage_id",
        "evidence_payload_hash",
        "decision",
        "reason_code",
        "decided_utc"
      ],
      "properties": {
        "schema": {
          "const": "rapp-cicd/1-promotion"
        },
        "release_payload_hash": {
          "$ref": "#/$defs/hex64"
        },
        "policy_payload_hash": {
          "$ref": "#/$defs/hex64"
        },
        "from_stage_id": {
          "$ref": "#/$defs/label"
        },
        "to_stage_id": {
          "$ref": "#/$defs/label"
        },
        "evidence_payload_hash": {
          "$ref": "#/$defs/hex64"
        },
        "decision": {
          "enum": [
            "promote",
            "hold",
            "reject"
          ]
        },
        "reason_code": {
          "$ref": "#/$defs/label"
        },
        "decided_utc": {
          "$ref": "#/$defs/utc"
        }
      }
    }
  }
}
